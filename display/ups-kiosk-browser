#!/bin/sh
set -eu

# Wait for PeaNUT before opening Chromium so boot does not leave an error page.
until curl --fail --silent --max-time 3 http://127.0.0.1:8080/api/ping >/dev/null; do
    sleep 2
done

# Ensure previous session tabs are not restored so the kiosk always opens the dashboard.
rm -rf /var/lib/ups-kiosk/chromium/Default/Sessions 2>/dev/null || true
if [ -f /var/lib/ups-kiosk/chromium/Default/Preferences ]; then
    sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/g' /var/lib/ups-kiosk/chromium/Default/Preferences 2>/dev/null || true
    sed -i 's/"exited_cleanly":false/"exited_cleanly":true/g' /var/lib/ups-kiosk/chromium/Default/Preferences 2>/dev/null || true
fi

exec /usr/bin/chromium \
    --ozone-platform=wayland \
    --kiosk \
    --no-first-run \
    --no-default-browser-check \
    --disable-session-crashed-bubble \
    --overscroll-history-navigation=0 \
    --disable-features=AutofillServerCommunication,PasswordManager \
    --disable-save-password-bubble \
    --password-store=basic \
    --user-data-dir=/var/lib/ups-kiosk/chromium \
    --load-extension=/usr/local/share/ups-kiosk/readability \
    --remote-debugging-address=127.0.0.1 \
    --remote-debugging-port=9222 \
    http://127.0.0.1:8080/device/ups
