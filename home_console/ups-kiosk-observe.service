[Unit]
Description=Bounded Home Console acceptance observation
After=network-online.target ups-kiosk.service
Wants=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /var/backups/home-console/20261027T210523Z/operator-stage/observe_pi.py --directory /var/backups/home-console/20261027T210523Z/observation
Restart=on-failure
RestartSec=60
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/home-console/20261027T210523Z/observation

[Install]
WantedBy=multi-user.target
