[Unit]
Description=UPS adapter configuration web
After=network.target ups-snmp.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 -u /usr/local/lib/ups-network-adapter/ups_web.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/ups-network-adapter /var/lib/ups-web /etc/ups-web-credentials.json /etc/ups-peanut.env /var/lib/ups-peanut
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=multi-user.target
