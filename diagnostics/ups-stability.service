[Unit]
Description=Seven-day UPS stability observation and pre-failure USB trace
After=nut-server.service ups-autodetect.service ups-snmp.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/modprobe usbmon
ExecStart=/usr/bin/python3 -u /usr/local/lib/ups-network-adapter/ups_stability.py
Restart=on-failure
RestartSec=30
LogsDirectory=ups-stability
LogsDirectoryMode=0700
UMask=0077
Nice=10
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/ups-stability

[Install]
WantedBy=multi-user.target
